{
  "name": "formakit-ant-adaptor",
  "version": "0.1.0",
  "private": false,
  "description": "Ant Design adaptor plugin for formakit",
  "keywords": [
    "react",
    "form",
    "formakit",
    "antd",
    "ant-design",
    "adaptor",
    "design-system"
  ],
  "type": "module",
  "main": "./dist/index.js",
