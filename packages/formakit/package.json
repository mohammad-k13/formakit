{
  "name": "formakit",
  "version": "0.1.1",
  "private": false,
  "description": "A config-driven React form builder with responsive grid layout, validation, and pluggable UI adaptors",
  "keywords": [
    "react",
    "form",
    "form-builder",
    "formkit",
    "validation",
    "grid",
    "config-driven",
    "typescript",
    "antd",
    "design-system"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohammad-k13/formakit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@repo/eslint-config": "*",
    "@types/react": "^18.2.0 || ^19.0.0",
    "@types/react-dom": "^18.2.0 || ^19.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "react-grid-layout": "^2.2.2"
  }
}
